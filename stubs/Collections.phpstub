<?php
// phpcs:ignoreFile
namespace Doctrine\Common\Collections;

use Closure;
use Countable;
use IteratorAggregate;
use ArrayAccess;

/**
 * @template TKey as array-key
 * @template T
 *
 * @template-extends ReadableCollection<TKey,T>
 * @template-extends ArrayAccess<TKey|null,T>
 */
interface Collection extends ReadableCollection, ArrayAccess
{

    /**
     * @param ?TKey $offset
     * @param T $value
     * @return void
     */
    public function offsetSet($offset, $value);

    /**
     * @param T $element
     * @return true
     */
    public function add($element);

    /**
     * @return void
     */
    public function clear();

    /**
     * @param TKey $key
     * @return T|null
     */
    public function remove($key);

    /**
     * @param T $element
     * @return bool
     */
    public function removeElement($element);

    /**
     * @param TKey $key
     * @param T $value
     * @return void
     */
    public function set($key, $value);

    /**
     * @param Closure(T=):bool $p
     * @return Collection<TKey,T>
     */
    public function filter(Closure $p);

    /**
     * @param Closure(TKey=,T=):bool $p
     * @return array{0:Collection<TKey,T>,1:Collection<TKey,T>}
     */
    public function partition(Closure $p);
}

/**
 * @template TKey as array-key
 * @template-covariant T
 *
 * @template-extends IteratorAggregate<TKey,T>
 */
interface ReadableCollection extends Countable, IteratorAggregate
{

    /**
     * @param T $element
     * @return bool
     */
    public function contains($element);

    /**
     * @return bool
     * @psalm-mutation-free
     */
    public function isEmpty();

    /**
     * @param TKey $key
     * @return bool
     */
    public function containsKey($key);

    /**
     * @param TKey $key
     * @return T|null
     */
    public function get($key);

    /**
     * @return list<TKey>
     */
    public function getKeys();

    /**
     * @return list<T>
     */
    public function getValues();

    /**
     * @return array<TKey,T>
     */
    public function toArray();

    /**
     * @return T|false
     */
    public function first();

    /**
     * @return T|false
     */
    public function last();

    /**
     * @return TKey|null
     */
    public function key();

    /**
     * @return T|false
     */
    public function current();

    /**
     * @return T|false
     */
    public function next();

    /**
     * @param int $offset
     * @param int|null $length
     * @return array<TKey,T>
     */
    public function slice($offset, $length = null);

    /**
     * @param Closure(TKey=,T=):bool $p
     * @return bool
     */
    public function exists(Closure $p);

    /**
     * @param Closure(T=):bool $p
     * @return ReadableCollection<TKey,T>
     */
    public function filter(Closure $p);

    /**
     * @template U
     * @param Closure(T=):U $func
     * @return Collection<TKey,U>
     */
    public function map(Closure $func);

    /**
     * @param Closure(TKey=,T=):bool $p
     * @return array{0:ReadableCollection<TKey,T>,1:ReadableCollection<TKey,T>}
     */
    public function partition(Closure $p);

    /**
     * @param Closure(TKey=,T=):bool $p
     * @return bool
     */
    public function forAll(Closure $p);

    /**
     * @param T $element
     * @return false|TKey
     */
    public function indexOf($element);
}

/**
 * @template TKey as array-key
 * @template T
 */
interface Selectable
{
    /**
     * @return Collection<TKey,T>
     */
    public function matching(Criteria $criteria);
}
